# [NEON_PROTOCOL] Environment Configuration

# Service Port (Amvera sets containerPort 8080 in amvera.yml)
PORT=8080

# SQLite on Amvera: leave unset — server uses /data/dev.db automatically.
# Local dev: file:./dev.db (default) or set explicitly:
# DATABASE_URL="file:./dev.db"

# Security (Replace with a strong random string on production)
JWT_SECRET="neon_core_secret_2026_CHANGE_ME"

# Client: Solo/Co-op for users who opened an NRI invite link (#nri/join/…).
# Amvera build sets false — those guests stay on NRI only; direct visitors unaffected.
# VITE_SOLO_COOP_PUBLIC=true
