generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  gameState    GameState?
}

model GameState {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id])
  
  stress       Int         @default(0)
  maxStress    Int         @default(100)
  bits         Int         @default(150)
  ramPool      Float       @default(1.0)
  xp           Int         @default(0)
  level        Int         @default(1)
  
  // JSON stores for complex structures
  activeDeck   Json
  inventory    Json
  artifacts    Json
  completedQuests Json
  reputation   Json?
  intel        Json?

  /** Полный JSON последнего /game/sync — sessionMode, currentView, activeDistrictId, coop_* и т.д. */
  clientSnapshot Json?

  updatedAt    DateTime    @updatedAt
}
