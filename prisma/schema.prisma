generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  gameState    GameState?
  coopStartupScore CoopStartupScore?
  chatMessages ChatMessage[]
  nriSessionsHosted NriSession[]
  nriPlayers NriPlayer[]
  nriSessionMembers NriSessionMember[]
  nriVaultFilesCreated NriVaultFile[]
  nriFileUnlocks NriFileUnlock[]
}

/** Стол НРИ: мастер создаёт, игроки заходят по inviteCode. */
model NriSession {
  id         String   @id @default(uuid())
  inviteCode String   @unique
  hostUserId String
  host       User     @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  title      String   @default("НРИ-сессия")
  chatRoomId String   @unique
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  status     String   @default("open")
  spamBotEnabled Boolean @default(false)
  spamPausedUntil DateTime?
  createdAt  DateTime @default(now())
  players    NriPlayer[]
  members    NriSessionMember[]
  vaultFiles NriVaultFile[]
  presets    NriPresetCharacter[]
  npcs       NriNpc[]
  combatants NriCombatant[]
  cyberProducts NriCyberProduct[]
  mapMarkers NriMapMarker[]
  vehicles   NriSessionVehicle[]
  iceScores  NriIceScore[]
  scenarioNodes NriScenarioNode[]
  loreWorld     NriLoreWorld?
  loreEntries   NriLoreEntry[]
  factions      NriFaction[]
  lorePlaces    NriLorePlace[]
  scenarioProgress NriScenarioProgress?
  playerPositions NriPlayerPosition[]
  hostAlerts    NriHostAlert[]
}

model NriSessionMember {
  id         String     @id @default(uuid())
  sessionId  String
  session    NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  username   String
  isHost     Boolean    @default(false)
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime   @updatedAt

  @@unique([sessionId, userId])
}

model NriPlayer {
  id          String   @id @default(uuid())
  sessionId   String
  session     NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  classId     String
  inventory   Json     @default("[]")
  sheet       Json?
  portraitUrl String?
  presetId    String?
  privateNotes String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, userId])
}

/** Заранее заполненный чарник — игрок выбирает и закрепляет за собой. */
model NriPresetCharacter {
  id              String     @id @default(uuid())
  sessionId       String
  session         NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  label           String
  classId         String
  inventory       Json       @default("[]")
  sheet           Json?
  portraitUrl     String?
  publishedToPlayers Boolean @default(false)
  sortOrder       Int        @default(0)
  claimedByUserId String?
  createdAt       DateTime   @default(now())

  @@index([sessionId, claimedByUserId])
}

/** Транспорт стола — мастер выдаёт, все видят. */
model NriSessionVehicle {
  id              String     @id @default(uuid())
  sessionId       String
  session         NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  catalogId       String
  label           String?
  assignedUserId  String?
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([sessionId])
}

/** Результаты ICE Run за столом — рейтинг аркады. */
model NriIceScore {
  id          String     @id @default(uuid())
  sessionId   String
  session     NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  displayName String
  score       Int
  exfilPct    Int        @default(0)
  tracePct    Int        @default(0)
  won         Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([sessionId, score])
}

/** Узел сценария стола — основной сюжет и ответвления-квесты. */
model NriScenarioNode {
  id         String     @id @default(uuid())
  sessionId  String
  session    NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     NriScenarioNode?  @relation("ScenarioTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   NriScenarioNode[] @relation("ScenarioTree")
  title      String
  body       String     @default("")
  sortOrder  Int        @default(0)
  links      Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([sessionId, parentId])
}

/** Общий лор мира стола (legacy — одно поле). */
model NriLoreWorld {
  sessionId String     @id
  session   NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  body      String     @default("")
  updatedAt DateTime   @updatedAt
}

/** Карточка лора мира (раздел «Мир»). */
model NriLoreEntry {
  id        String     @id @default(uuid())
  sessionId String
  session   NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String
  body      String     @default("")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sessionId, sortOrder])
}

/** Фракция — игроки и НПС. */
model NriFaction {
  id              String     @id @default(uuid())
  sessionId       String
  session         NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind            String     @default("faction")
  name            String
  description     String     @default("")
  color           String?
  zoneKeys        Json       @default("[]")
  memberPlayerIds Json
  memberNpcIds    Json
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([sessionId])
}

/** Карточка места в лоре (из сценария или вручную). */
model NriLorePlace {
  id                   String     @id @default(uuid())
  sessionId            String
  session              NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title                String
  body                 String     @default("")
  zoneKey              String?
  mapMarkerId          String?
  x                    Float?
  y                    Float?
  sourceScenarioNodeId String?
  sourceFactionId      String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([sessionId])
}

/** Текущий пункт сценария (чтобы не засчитывать ранние приходы). */
model NriScenarioProgress {
  sessionId          String     @id
  session            NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  currentScriptNodeId String?
  completedNodeIds   Json
  updatedAt          DateTime   @updatedAt
}

/** Позиция игрока на карте. */
model NriPlayerPosition {
  id              String     @id @default(uuid())
  sessionId       String
  session         NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  zoneKey         String?
  x               Float?
  y               Float?
  vehicleId       String?
  vehicleOverload Boolean    @default(false)
  updatedAt       DateTime   @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId, zoneKey])
}

/** Служебные уведомления мастеру (дублируются в личку). */
model NriHostAlert {
  id         String     @id @default(uuid())
  sessionId  String
  session    NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromUserId String
  kind       String
  body       String
  read       Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([sessionId, read])
}

/** НПС стола — чарник, портрет, инвентарь; мастер пишет в чат от их лица. */
model NriNpc {
  id          String     @id @default(uuid())
  sessionId   String
  session     NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  classId     String?
  imageUrl    String?
  inventory   Json       @default("[]")
  sheet       Json?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/** Противник-боевик стола — лист для боя; только мастер. */
model NriCombatant {
  id          String     @id @default(uuid())
  sessionId   String
  session     NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  classId     String?
  archetypeId String?
  threatTier  String     @default("street")
  imageUrl    String?
  inventory   Json       @default("[]")
  sheet       Json?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sessionId])
}

/** Киберимплант / товар лавки — blueprint + цена; позже привязка к НПС-торговцу. */
model NriCyberProduct {
  id          String     @id @default(uuid())
  sessionId   String
  session     NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  slot        String
  blueprint   Json
  build       Json
  priceWonlongs Int      @default(0)
  inShop      Boolean    @default(false)
  vendorNpcId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sessionId, inShop])
}

/** Метки на карте мегаполиса (Night City) — мастер и игроки. */
model NriMapMarker {
  id          String     @id @default(uuid())
  sessionId   String
  session     NriSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ownerUserId String?
  label       String
  blurb       String?
  x           Float
  y           Float
  /** host | player (legacy: pin → host) */
  kind        String     @default("player")
  createdAt   DateTime   @default(now())

  @@index([sessionId])
  @@index([sessionId, ownerUserId])
}

/** Районы карты Night City — названия и геометрия (редактируемые). */
model NriMapZone {
  zoneKey   String   @id
  sortOrder Int      @default(0)
  name      String
  zoneType  String
  x         Float
  y         Float
  w         Float
  h         Float
  corpName      String?
  megaDistrict  String?
  color         String?
  locked        Boolean  @default(false)
  pois      Json?
  updatedAt DateTime @updatedAt
}

model NriVaultFile {
  id             String   @id @default(uuid())
  sessionId      String?
  session        NriSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title          String
  body           String
  protected      Boolean  @default(false)
  passwordHash   String?
  /** Plaintext код-награда — только если пароль + ICE; выдаётся после мини-игры. */
  iceRewardCode  String?
  gameId         String?
  difficulty     String?
  createdById    String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  unlocks     NriFileUnlock[]
}

model NriFileUnlock {
  id          String    @id @default(uuid())
  fileId      String
  file        NriVaultFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  icePassedAt DateTime?
  unlockedAt  DateTime?

  @@unique([fileId, userId])
}

/** Мета комнаты чата (SPAM-бот #general и т.д.). */
model ChatRoomMeta {
  roomId          String   @id
  room            ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  spamBotEnabled  Boolean  @default(false)
}

/** Комната чата: общий канал (`slug`), личка (`dmKey`) или стол НРИ (`kind=nri`). */
model ChatRoom {
  id         String        @id @default(uuid())
  kind       String
  slug       String?       @unique
  dmKey      String?       @unique
  createdAt  DateTime      @default(now())
  messages   ChatMessage[]
  nriSession NriSession?
  meta       ChatRoomMeta?
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  payload   String?
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

/** Лучший результат игрока в рейтинге стартапов коопа (для GET /neon_v1/coop/startup-rankings). */
model CoopStartupScore {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupName     String
  score           Int
  tierRank        String
  missionsCleared Int      @default(0)
  bits            Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/** Активный кооп-матч (live_party) — JSON-состояние боя, переживает рестарт процесса. */
model CoopLiveMatch {
  id                        String   @id
  partyId                   String   @unique
  hostId                    String
  status                    String
  memberIds                 Json
  roleByUserId              Json
  shared                    Json
  events                    Json
  intentQueue               Json
  seq                       Int      @default(0)
  linkedObjectiveAwardedIds Json?
  createdAt                 DateTime
  updatedAt                 DateTime

  @@index([status])
}

model GameState {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id])
  
  stress       Int         @default(0)
  maxStress    Int         @default(100)
  bits         Int         @default(150)
  ramPool      Float       @default(1.0)
  xp           Int         @default(0)
  level        Int         @default(1)
  
  // JSON stores for complex structures
  activeDeck   Json
  inventory    Json
  artifacts    Json
  completedQuests Json
  reputation   Json?
  intel        Json?

  /** Полный JSON последнего /game/sync — sessionMode, currentView, activeDistrictId, coop_* и т.д. */
  clientSnapshot Json?

  updatedAt    DateTime    @updatedAt
}
