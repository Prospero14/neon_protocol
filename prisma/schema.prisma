generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  gameState    GameState?
}

model GameState {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id])
  
  hp           Int         @default(100)
  maxHp        Int         @default(100)
  bits         Int         @default(100)
  xp           Int         @default(0)
  level        Int         @default(1)
  
  // JSON stores for complex structures
  activeDeck   Json        @default("[]")
  inventory    Json        @default("[]")
  artifacts    Json        @default("[]")
  completedQuests Json     @default("[]")
  
  updatedAt    DateTime    @updatedAt
}
