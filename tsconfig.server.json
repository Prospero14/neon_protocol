{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["es2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "outDir": "./dist_server",
    "rootDir": ".",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["server/**/*.ts", "shared/nri-domain/**/*.ts", "shared/api-schemas/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "shared/**/*.test.ts", "node_modules", "dist_server"]
}
